    BLOCK "080404B0"
    BEGIN
      VALUE "CompanyName", "循人中学 Tsun Jin High School"
      VALUE "FileDescription", "循人中学 教师与班级课表"
      VALUE "ProductName", "循人课表"
      VALUE "FileVersion", "@VERSION@"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "OriginalFilename", "Teacher-TimeTable.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
